# Frontend-exposed variables (do not put secrets here)
VITE_GEMINI_API_KEY=

# Server-only secret for Vercel function
GEMINI_API_KEY=

# Optional model override for explanation route
GEMINI_EXPLAIN_MODEL=gemini-2.5-flash

# Kill switch for /api/explain (1 = always fallback)
EXPLAIN_DISABLED=0

# Optional provider selector (currently only "gemini")
EXPLAIN_PROVIDER=gemini

# Optional: requests/minute per IP for /api/explain (0 disables limiting)
EXPLAIN_RATE_LIMIT_PER_MINUTE=0

# Optional KV (tiered cache: in-memory + KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
